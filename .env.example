# ---------------------------------------------------------------------------
# ARA AI Academy – environment variables
# Copy to .env.local for local development. In Vercel, add them under
# Project → Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used in emails, certificate QR codes and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe for the browser; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com). Leave empty to disable outgoing email (emails are logged as "skipped").
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "ARA AI Academy <academy@yourdomain.sr>"
EMAIL_FROM=
# Optional fallback address for admin notifications (new payments, contact messages).
ADMIN_NOTIFICATION_EMAIL=

# Random secret used by Vercel Cron to call /api/cron/daily (generate: openssl rand -hex 32)
CRON_SECRET=
